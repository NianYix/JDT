# Application
APP_NAME=AI Engineering Copilot
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Database (SQLAlchemy URL for Backend)
DATABASE_URL=postgresql+psycopg://aec:aec@localhost:5432/aec

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (JWT) — replace JWT_SECRET_KEY in real deployments
JWT_SECRET_KEY=change-me-in-development-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin console (SQLAdmin at /admin) — change password before production
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
# Optional; falls back to JWT_SECRET_KEY when empty
ADMIN_SESSION_SECRET=

# LLM (OpenAI-compatible) — leave LLM_API_KEY empty until configured
LLM_ENABLED=true
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/
LLM_TIMEOUT_SECONDS=90

# Docker Compose PostgreSQL
POSTGRES_USER=aec
POSTGRES_PASSWORD=aec
POSTGRES_DB=aec
POSTGRES_PORT=5432

# Docker Compose Redis
REDIS_PORT=6379
